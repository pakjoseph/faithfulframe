function(faithfulframe_extract_macos_minimum_versions output_variable load_commands)
	set(_minimum_versions)
	string(REGEX MATCHALL "minos[ \t]+[0-9]+(\\.[0-9]+)*" _modern_minimum_versions "${load_commands}")
	foreach(_entry IN LISTS _modern_minimum_versions)
		string(REGEX REPLACE "^minos[ \t]+" "" _minimum_version "${_entry}")
		list(APPEND _minimum_versions "${_minimum_version}")
	endforeach()

	string(REPLACE "\n" ";" _load_command_lines "${load_commands}")
	set(_legacy_minimum_pending FALSE)
	foreach(_line IN LISTS _load_command_lines)
		if(_line MATCHES "^[ \t]*cmd[ \t]+")
			if(_line MATCHES "^[ \t]*cmd[ \t]+LC_VERSION_MIN_MACOSX[ \t]*$")
				set(_legacy_minimum_pending TRUE)
			else()
				set(_legacy_minimum_pending FALSE)
			endif()
		elseif(_legacy_minimum_pending AND _line MATCHES "^[ \t]*version[ \t]+([0-9]+(\\.[0-9]+)*)[ \t]*$")
			list(APPEND _minimum_versions "${CMAKE_MATCH_1}")
			set(_legacy_minimum_pending FALSE)
		endif()
	endforeach()
	list(REMOVE_DUPLICATES _minimum_versions)
	set(${output_variable} "${_minimum_versions}" PARENT_SCOPE)
endfunction()
